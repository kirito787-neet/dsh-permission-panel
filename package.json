{
  "name": "dsh-permission-panel",
  "version": "3.1.0",
  "description": "DSH 工作区权限面板（Web / Desktop 双载体）：在「设置 → 工作区权限」里统一查看与切换每个会话的权限预设（沙盒模式 + 审批策略），支持批量选择一键修改、自动跳过已归档会话，并可设置新会话的默认权限；另提供一个「重启 DSH」命令（仅 Desktop，Ctrl+Shift+R）。",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "dsh-permission-panel",
    "hotkey",
    "shortcut",
    "shortcuts",
    "keybinding",
    "permission",
    "plugin"
  ],
  "license": "MIT",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "peerDependencies": {
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-shortcuts",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "scripts": {
    "test": "node test/binding-audit.cjs && node test/dictionaries.cjs && node test/host-api.cjs && node test/legacy-model-search.cjs && node test/smoke.cjs && node test/platform.cjs",
    "verify:profile": "node tools/verify-profile.cjs web",
    "verify:coexistence": "node tools/verify-coexistence.cjs web"
  }
}
