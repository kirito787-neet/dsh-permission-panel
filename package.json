{
  "name": "dsh-hotkey-toolkit",
  "version": "1.1.1",
  "description": "DSH 快捷键工具包：Ctrl+R 刷新界面、Ctrl+Shift+R 重启 DSH、可自定义组合键切换兼容/扩展/增强模式，输入框模型选择列表上方提供模型搜索框，并新增工作区权限面板统一查看与切换所有会话的权限预设。",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
