{
  "name": "dsh-permission-panel",
  "version": "3.2.0",
  "description": "DSH 工作区权限面板（Web / Desktop 双载体）：按工作区分组列出每个会话的权限预设，支持搜索、两级全选与批量修改，自动跳过已归档会话，可设置新会话默认权限，并显示当前会话实际生效的策略；另提供「重启 DSH」命令（仅 Desktop）。",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "dsh-permission-panel",
    "hotkey",
    "shortcut",
    "shortcuts",
    "keybinding",
    "permission",
    "plugin"
  ],
  "license": "MIT",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "peerDependencies": {
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-shortcuts",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "scripts": {
    "test": "node test/binding-audit.cjs && node test/dictionaries.cjs && node test/host-api.cjs && node test/legacy-model-search.cjs && node test/smoke.cjs && node test/platform.cjs",
    "verify:profile": "node tools/verify-profile.cjs web",
    "verify:coexistence": "node tools/verify-coexistence.cjs web"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kirito787-neet/dsh-permission-panel.git"
  },
  "homepage": "https://github.com/kirito787-neet/dsh-permission-panel#readme",
  "bugs": {
    "url": "https://github.com/kirito787-neet/dsh-permission-panel/issues"
  }
}
