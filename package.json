{
  "name": "dsh-hotkey-toolkit",
  "version": "2.0.0",
  "description": "DSH 快捷键工具包（Web / Desktop 双载体）：快捷键已并入官方「设置 → 快捷键」界面（可录制 / 可恢复默认 / 与官方命令统一冲突检测），每个快捷键均可单独开关；工作区权限面板统一查看与切换所有会话的权限预设（支持批量选择一键修改，自动跳过已归档会话）。模型选择器搜索框已迁出，见 dsh-client-ui-effort-slider。",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "dsh-hotkey-toolkit",
    "hotkey",
    "shortcut",
    "shortcuts",
    "keybinding",
    "permission",
    "plugin"
  ],
  "license": "MIT",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "peerDependencies": {
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-shortcuts",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "scripts": {
    "test": "node test/binding-audit.cjs && node test/dictionaries.cjs && node test/host-api.cjs && node test/legacy-model-search.cjs && node test/smoke.cjs && node test/platform.cjs",
    "verify:profile": "node tools/verify-profile.cjs web",
    "verify:coexistence": "node tools/verify-coexistence.cjs web"
  }
}
